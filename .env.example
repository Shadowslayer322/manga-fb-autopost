# API Key de CapibaraTraductor (Admin -> API en tu panel del scan)
CAPI_API_KEY=capi_tu_clave_aqui

# Opcional: URL base de la API v1 de CapibaraTraductor
CAPI_BASE_URL=https://capibaratraductor.com/api/v1

# Datos de tu Página de Facebook (Meta Graph API)
FB_PAGE_ID=123456789012345
FB_PAGE_ACCESS_TOKEN=EAAG...

# Opcional: máximo de publicaciones por ejecución
MAX_POSTS_PER_RUN=5
